{
    "name": "componenta/http-body-parsing-middleware",
    "description": "PSR-15 request body parsing middleware for Componenta",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "ext-mbstring": "*",
        "componenta/config": "^3.0 || ^4.0",
        "psr/container": "^2.0",
        "psr/http-factory": "^1.1",
        "psr/http-message": "^2.0",
        "psr/http-server-middleware": "^1.0",
        "psr/http-server-handler": "^1.0",
        "ext-ctype": "*"
    },
    "require-dev": {
        "nyholm/psr7": "^1.8.2",
        "phpunit/phpunit": "^12.0",
        "phpstan/phpstan": "^2.1",
        "phpbench/phpbench": "^1.7",
        "infection/infection": "^0.35.4"
    },
    "autoload": {
        "psr-4": {
            "Componenta\\Http\\Middleware\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Componenta\\Http\\Middleware\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "@php vendor/bin/phpunit --configuration phpunit.xml.dist",
        "phpstan": "@php vendor/bin/phpstan analyse src --level=8 --no-progress",
        "check": [
            "@phpstan",
            "@test"
        ],
        "benchmark": "@php vendor/bin/phpbench run --report=aggregate",
        "mutation": "@php vendor/bin/infection --threads=4 --min-msi=80 --min-covered-msi=80 --no-progress"
    },
    "minimum-stability": "stable",
    "extra": {
        "componenta": {
            "config-providers": [
                "Componenta\\Http\\Middleware\\BodyParsingConfigProvider"
            ]
        },
        "branch-alias": {
            "dev-main": "1.1.x-dev"
        }
    },
    "config": {
        "audit": {
            "ignore-abandoned": {
                "doctrine/annotations": "Transitive PHPBench development-only dependency; benchmarks use native attributes. Security advisories remain enforced."
            }
        },
        "allow-plugins": {
            "infection/extension-installer": true
        }
    }
}
